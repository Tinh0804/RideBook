# ==============================================================================
# RideBook Production Environment Configuration (.env.example)
# ==============================================================================
# Copy this file to .env and provide the actual values for production.
# WARNING: NEVER commit the actual .env file with production credentials to Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# Container Images
# ------------------------------------------------------------------------------
BACKEND_IMAGE=tinh0804/ridebook-backend:latest
POSTGRES_IMAGE=postgres:15.18-alpine
REDIS_IMAGE=redis:7.4-alpine
NGINX_IMAGE=nginx:alpine

# ------------------------------------------------------------------------------
# Domain & SSL / TLS Configuration
# ------------------------------------------------------------------------------
DOMAIN=api.ridebook.example.com
LETSENCRYPT_DIR=/etc/letsencrypt
ACME_WEBROOT=/var/www/ridebook-certbot

# ------------------------------------------------------------------------------
# Database (PostgreSQL) Configuration
# ------------------------------------------------------------------------------
DB_NAME=RideBookDB
DB_USERNAME=ridebook
DB_PASSWORD=replace_with_strong_database_password

# ------------------------------------------------------------------------------
# Redis Cache Configuration
# ------------------------------------------------------------------------------
REDIS_DATABASE=0

# ------------------------------------------------------------------------------
# JVM & Spring Security Settings
# ------------------------------------------------------------------------------
JAVA_TOOL_OPTIONS=-Xms256m -Xmx896m -XX:+UseG1GC -XX:+ExitOnOutOfMemoryError
SECURITY_USER_NAME=admin
SECURITY_USER_PASSWORD=replace_with_strong_security_admin_password

# ------------------------------------------------------------------------------
# JWT Authentication
# ------------------------------------------------------------------------------
# Must be at least 256 bits (32 characters or base64 encoded string)
JWT_SIGNER_KEY=replace_with_secure_256_bit_jwt_signer_key_here

# ------------------------------------------------------------------------------
# Frontend & CORS Origins
# ------------------------------------------------------------------------------
FRONTEND_URL=https://ridebook.example.com
CORS_ALLOWED_ORIGINS=https://ridebook.example.com

# ------------------------------------------------------------------------------
# OAuth2 Social Login Providers
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://api.ridebook.example.com/RideBook/login/oauth2/code/google

FACEBOOK_CLIENT_ID=your_facebook_client_id
FACEBOOK_CLIENT_SECRET=your_facebook_client_secret
FACEBOOK_REDIRECT_URI=https://api.ridebook.example.com/RideBook/login/oauth2/code/facebook

# ------------------------------------------------------------------------------
# Payment Gateways (VNPay & MoMo)
# ------------------------------------------------------------------------------
VNPAY_TMN_CODE=your_vnpay_tmn_code
VNPAY_HASH_SECRET=your_vnpay_hash_secret
VNPAY_API_URL=https://pay.vnpay.vn/vpcpay.html
VNPAY_RETURN_URL=https://api.ridebook.example.com/RideBook/api/v1/payment/vnpay-return

MOMO_PARTNER_CODE=your_momo_partner_code
MOMO_ACCESS_KEY=your_momo_access_key
MOMO_SECRET_KEY=your_momo_secret_key
MOMO_API_URL=https://payment.momo.vn/v2/gateway/api/create
MOMO_RETURN_URL=https://api.ridebook.example.com/RideBook/api/v1/payment/momo-return
MOMO_NOTIFY_URL=https://api.ridebook.example.com/RideBook/api/v1/payment/momo-ipn

# ------------------------------------------------------------------------------
# Google Maps API Key
# ------------------------------------------------------------------------------
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# ------------------------------------------------------------------------------
# Firebase Service Account
# ------------------------------------------------------------------------------
FIREBASE_CONFIG_PATH=/app/firebase-service-account.json
