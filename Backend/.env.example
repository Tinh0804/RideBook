# Docker Compose
BACKEND_ENV_FILE=.env
BACKEND_PORT=8080
POSTGRES_PORT=5432
REDIS_PORT=6379
# KEYCLOAK_PORT=8180

# Local PostgreSQL
DB_NAME=ridebook
DB_URL=jdbc:postgresql://postgres:5432/ridebook
DB_USERNAME=ridebook
DB_PASSWORD=replace-me
# Optional parked Keycloak database. Uncomment only when restoring Keycloak.
# KEYCLOAK_DB_NAME=keycloak
# KEYCLOAK_DB_URL=jdbc:postgresql://postgres:5432/keycloak
# KEYCLOAK_DB_USERNAME=keycloak
# KEYCLOAK_DB_PASSWORD=replace-me

# Production images/network
BACKEND_IMAGE=your-registry/ridebook-backend:latest
# KEYCLOAK_IMAGE=your-registry/ridebook-keycloak:26.7.0
DOCKER_NETWORK=shared-network

# Optional parked Keycloak runtime
# KEYCLOAK_ADMIN=admin
# KEYCLOAK_ADMIN_PASSWORD=replace-me
# KEYCLOAK_HOSTNAME=http://localhost:8180
# KEYCLOAK_PROVISIONER_CLIENT_SECRET=replace-me

# Optional Keycloak user-storage connection. Use a read-only Backend database user.
# RIDEBOOK_DB_URL=jdbc:postgresql://postgres:5432/ridebook
# RIDEBOOK_DB_USERNAME=ridebook_readonly
# RIDEBOOK_DB_PASSWORD=replace-me

# Redis
REDIS_URL=redis://redis:6379
REDIS_DATABASE=0

# Backend security
SECURITY_USER_NAME=ridebook
SECURITY_USER_PASSWORD=replace-me
JWT_SIGNER_KEY=replace-with-at-least-32-byte-secret
FRONTEND_URL=http://localhost:5173

# OAuth providers
GOOGLE_CLIENT_ID=replace-me
GOOGLE_CLIENT_SECRET=replace-me
GOOGLE_REDIRECT_URI=http://localhost:5173/oauth2/callback/google
FACEBOOK_CLIENT_ID=replace-me
FACEBOOK_CLIENT_SECRET=replace-me
FACEBOOK_REDIRECT_URI=http://localhost:5173/oauth2/callback/facebook

# External services
FIREBASE_CONFIG_PATH=
GOOGLE_MAPS_API_KEY=replace-me
VNPAY_TMN_CODE=replace-me
VNPAY_HASH_SECRET=replace-me
VNPAY_API_URL=https://example.invalid/vnpay
VNPAY_RETURN_URL=http://localhost:5173/payment/vnpay/return
MOMO_PARTNER_CODE=replace-me
MOMO_ACCESS_KEY=replace-me
MOMO_SECRET_KEY=replace-me
MOMO_API_URL=https://example.invalid/momo
MOMO_RETURN_URL=http://localhost:5173/payment/momo/return
MOMO_NOTIFY_URL=http://localhost:8080/RideBook/payments/momo/notify
